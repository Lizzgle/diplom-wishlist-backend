{
  "SwaggerEndPoints": [
  {
    "Key": "identity",
    "Config": [
      {
        "Name": "User api",
        "Version": "v1",
        "Url": "http://identity.api:8080/swagger/v1/swagger.json"
      }
    ]
  },
  {
    "Key": "wishlist",
    "Config": [
      {
        "Name": "Wishlist api",
        "Version": "v1",
        "Url": "http://wishlist.api:8080/swagger/v1/swagger.json"
      }
    ]
  },
  {
    "Key": "event",
    "Config": [
      {
        "Name": "Event api",
        "Version": "v1",
        "Url": "http://event.api:8080/swagger/v1/swagger.json"
      }
    ]
  },
  {
    "Key": "secretSanta",
    "Config": [
      {
        "Name": "Secret santa api",
        "Version": "v1",
        "Url": "http://santa.api:8080/swagger/v1/swagger.json"
      }
    ]
  }
],
  "GlobalConfiguration": {
    "BaseUrl": "http://apigateway:8080"
  },
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/account/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/account/{everything}",
      "UpstreamHttpMethod": [ "Get", "Put", "Post" ],
      "SwaggerKey": "identity"
    },
    {
      "DownstreamPathTemplate": "/api/users/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/users/{everything}",
      "UpstreamHttpMethod": [ "Get", "Put", "Delete" ],
      "SwaggerKey": "identity"
    },
    {
      "DownstreamPathTemplate": "/api/friend-requests/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/friend-requests/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Patch", "Delete" ],
      "SwaggerKey": "identity"
    },
    {
      "DownstreamPathTemplate": "/api/friends/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "identity.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/friends/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "SwaggerKey": "identity"
    },


    {
      "DownstreamPathTemplate": "/api/wishlists/{wishlistId}/wishes/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "wishlist.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/wishlists/{wishlistId}/wishes/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "SwaggerKey": "wishlist"
    },
    {
      "DownstreamPathTemplate": "/api/wishlists/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "wishlist.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/wishlists/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "SwaggerKey": "wishlist"
    },
    
    
    {
      "DownstreamPathTemplate": "/api/events/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "event.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/events/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "SwaggerKey": "event"
    },

    
    {
      "DownstreamPathTemplate": "/api/invitations/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "event.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/invitations/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "SwaggerKey": "event"
    },



    {
      "DownstreamPathTemplate": "/api/games/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "santa.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/games/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Patch" ],
      "SwaggerKey": "santa"
    },


    {
      "DownstreamPathTemplate": "/api/players/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "santa.api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/players/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ],
      "SwaggerKey": "santa"
    }
  ]
}